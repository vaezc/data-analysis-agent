# ============================================================
# Data Analysis Agent —— 本地运行环境变量模板
#
# 用法：
#   cp .env.local.example .env.local
#
# 注意：
#   - .env.local 不入 git，只放应用运行时 secret。
#   - Prisma CLI 只读 .env，不读 .env.local。
#   - 数据库连接请放到 .env：DATABASE_URL / DIRECT_URL。
# ============================================================

# ---------- LLM ----------
# 当前支持：deepseek（默认）、openai。claude 待实现。
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-or-openai-key

# 可选：覆盖默认模型。DeepSeek 默认 deepseek-v4-flash，OpenAI 默认 gpt-4o。
# LLM_MODEL=deepseek-v4-flash

# 可选：打开 LLM 请求/响应日志（仅服务端，会刷终端）。
# LLM_DEBUG=1
# LLM_DEBUG=full
# LLM_DEBUG_MAX_CHARS=1000

# ---------- Auth.js v5 ----------
# JWT 签名密钥，生产环境必须 >=32 字节随机串。
# 生成命令：openssl rand -base64 32
AUTH_SECRET=

# 本地开发地址。生产环境在 Vercel 里填真实域名。
AUTH_URL=http://localhost:3000

# ---------- OAuth providers（可选） ----------
# Google:
#   https://console.cloud.google.com/ → APIs & Services → Credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# GitHub:
#   https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# GITHUB_CLIENT_ID="Ov23xxx"
# GITHUB_CLIENT_SECRET="xxx"

# ---------- Email（Resend，邮箱验证用） ----------
# Dashboard → API Keys: https://resend.com
# RESEND_API_KEY="re_xxxxxxxx"

# 默认 sandbox 地址只能发到你 Resend 账号的注册邮箱。
# 生产建议 verify 自有域名后使用 noreply@yourdomain.com。
# RESEND_FROM_EMAIL="onboarding@resend.dev"
