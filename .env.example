# ============================================================
# Data Analysis Agent —— 环境变量模板
#
# 用法：
#   - 本地运行：数据库连接放 .env；应用 secret 放 .env.local（见 .env.local.example）。
#   - Vercel 部署：按本文件逐项配置 Environment Variables。
# .env / .env.local 不入 git；.env.example 入 git（团队 / 部署参考）。
# ============================================================

# ---------- LLM ----------
# 当前支持：deepseek（默认）、openai。claude 待实现。
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-or-openai-key
# 可选：覆盖默认模型。DeepSeek 默认 deepseek-v4-flash，OpenAI 默认 gpt-4o
# LLM_MODEL=deepseek-v4-flash

# 可选：打开 LLM 请求/响应日志（仅服务端，会刷终端）
# LLM_DEBUG=1
# LLM_DEBUG=full         # 不截断
# LLM_DEBUG_MAX_CHARS=1000

# ---------- Database (Supabase Postgres via Prisma) ----------
# DATABASE_URL：应用运行时连接，必须走 Supavisor pooler（端口 6543）
#   - 后缀 ?pgbouncer=true&connection_limit=1 是 Vercel Serverless 推荐配置
#   - 密码含 @ [ ] 等特殊字符必须 URL 编码（@ -> %40, ] -> %5D）
DATABASE_URL="postgresql://postgres.PROJECTREF:URL_ENCODED_PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL：直连（端口 5432），仅 prisma migrate 时使用。
#   - 不要在应用代码里用这个连接，会打爆免费版连接池。
DIRECT_URL="postgresql://postgres.PROJECTREF:URL_ENCODED_PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres"

# ---------- Auth.js v5 (S6 起启用) ----------
# AUTH_SECRET：JWT 签名密钥，生产环境必须 >=32 字节随机串
#   生成命令：openssl rand -base64 32
# AUTH_SECRET=

# AUTH_URL：本地 dev 用 http://localhost:3000；生产用真实域名
# AUTH_URL=http://localhost:3000

# 部署到 Vercel 时建议加：
# AUTH_TRUST_HOST=true

# ---------- OAuth providers ----------
# Google: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# GitHub: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID="Ov23xxx"
# GITHUB_CLIENT_SECRET="xxx"

# ---------- Email (Resend，邮箱验证用) ----------
# 在 https://resend.com 注册（免费 100 封/天），Dashboard → API Keys 拿这个
# RESEND_API_KEY="re_xxxxxxxx"

# 发件人地址：
#   - 默认 sandbox: onboarding@resend.dev（只能发到你 Resend 账号的注册邮箱）
#   - 生产：自己 verify 一个域名后用 noreply@yourdomain.com
# RESEND_FROM_EMAIL="onboarding@resend.dev"
